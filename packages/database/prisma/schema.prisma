// Prisma 7: the "prisma-client" generator (not the legacy "prisma-client-js")
// is required, with an explicit output path - see
// https://www.prisma.io/docs/orm/more/upgrades/to-v7
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // The connection URL itself lives in prisma.config.ts (Prisma 7 moved it
  // out of schema.prisma); this block only declares the provider.
  provider = "postgresql"
}

// Base migration (Task 03): only SystemSetting and OutboxEvent. Every future
// domain table arrives in its own task's own migration - see
// docs/new-plan.md section 12 (data model contract) and its migration rule
// "migration اعمال‌شده را rewrite نکن؛ migration جدید بساز".

/// Generic admin-adjustable key/value store for runtime configuration that
/// doesn't warrant its own table (feature flags, thresholds, etc.).
model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("system_settings")
}

/// Transactional outbox: domain writes append a row here in the same
/// transaction as the aggregate change, and a worker polls/publishes it
/// at-least-once. See docs/new-plan.md section 12's migration rule: "outbox
/// event در همان transaction تغییر aggregate نوشته می‌شود."
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String
  aggregateId   String    @db.Uuid
  eventType     String
  payload       Json
  availableAt   DateTime  @default(now()) @db.Timestamptz(6)
  processedAt   DateTime? @db.Timestamptz(6)
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  @@index([processedAt, availableAt])
  @@map("outbox_events")
}
