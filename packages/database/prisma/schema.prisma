// Prisma 7: the "prisma-client" generator (not the legacy "prisma-client-js")
// is required, with an explicit output path - see
// https://www.prisma.io/docs/orm/more/upgrades/to-v7
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // The connection URL itself lives in prisma.config.ts (Prisma 7 moved it
  // out of schema.prisma); this block only declares the provider.
  provider = "postgresql"
}

// Base migration (Task 03): only SystemSetting and OutboxEvent. Every future
// domain table arrives in its own task's own migration - see
// docs/new-plan.md section 12 (data model contract) and its migration rule
// "migration اعمال‌شده را rewrite نکن؛ migration جدید بساز".

/// Generic admin-adjustable key/value store for runtime configuration that
/// doesn't warrant its own table (feature flags, thresholds, etc.).
model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("system_settings")
}

/// Transactional outbox: domain writes append a row here in the same
/// transaction as the aggregate change, and a worker polls/publishes it
/// at-least-once. See docs/new-plan.md section 12's migration rule: "outbox
/// event در همان transaction تغییر aggregate نوشته می‌شود."
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String
  aggregateId   String    @db.Uuid
  eventType     String
  payload       Json
  availableAt   DateTime  @default(now()) @db.Timestamptz(6)
  processedAt   DateTime? @db.Timestamptz(6)
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  @@index([processedAt, availableAt])
  @@map("outbox_events")
}

// Task 05: identity foundation. New migration, additive only - the
// SystemSetting/OutboxEvent migration above stays untouched (Global
// Constraint: "migration اعمال‌شده را rewrite نکن؛ migration جدید بساز").

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id         String     @id @default(uuid()) @db.Uuid
  status     UserStatus @default(ACTIVE)
  lastSeenAt DateTime?  @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(6)

  phoneIdentity                   PhoneIdentity?
  profile                         UserProfile?
  officialIdentityClaim           OfficialIdentityClaim?
  mfaEnrollment                   MfaEnrollment?
  sessions                        Session[]
  devices                         Device[]
  termsAcceptances                TermsAcceptance[]
  roleAssignments                 RoleAssignment[]         @relation("RoleAssignmentUser")
  roleAssignmentsGranted          RoleAssignment[]         @relation("RoleAssignmentAssignedBy")
  spacesCreated                   Space[]                  @relation("SpaceCreator")
  spaceDefinitionVersionsAuthored SpaceDefinitionVersion[] @relation("SpaceDefinitionVersionCreatedBy")
  spaceRoleMemberships            SpaceRoleMembership[]    @relation("SpaceRoleMembershipUser")
  spaceInvitesCreated             SpaceInvite[]            @relation("SpaceInviteCreatedBy")
  spaceFollowing                  SpaceFollower[]          @relation("SpaceFollowerUser")
  cardsAuthored                   Card[]                   @relation("CardAuthor")
  cardRevisionsEdited             CardRevision[]           @relation("CardRevisionEditor")
  cardAttachmentsOwned            CardAttachment[]         @relation("CardAttachmentOwner")
  cardCommentsAuthored            CardComment[]            @relation("CardCommentAuthor")
  cardCommentRevisionsEdited      CardCommentRevision[]    @relation("CardCommentRevisionEditor")
  cardReactions                   CardReaction[]           @relation("CardReactionUser")
  cardPinsCreated                 CardPin[]                @relation("CardPinnedBy")
  cardReservationsOwned           CardReservation[]        @relation("CardReservationOwner")
  cardReservationsMade            CardReservation[]        @relation("CardReservationReserver")
  conversationMemberships         ConversationMember[]     @relation("ConversationMemberUser")

  @@index([status])
  @@map("users")
}

/// The only place a phone number's ciphertext/hash live. `plaintext` is
/// never stored - see phone-crypto.ts. `ON DELETE RESTRICT`: deleting a
/// user's identity record is a deliberate, audited operation, never an
/// accidental cascade from deleting something else.
model PhoneIdentity {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  phoneHash       String    @unique
  phoneCiphertext String
  verifiedAt      DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("phone_identities")
}

enum PhoneVisibility {
  PRIVATE
  PUBLIC
}

/// `username` is intentionally NOT marked @unique here: section 12 requires
/// a case-insensitive unique constraint ("unique lower(username)"), which
/// Prisma's schema DSL cannot express as a functional index. The migration
/// adds `CREATE UNIQUE INDEX ... ON user_profiles (lower(username))`
/// directly; callers must query with Prisma's `mode: 'insensitive'` filter
/// (Task 08, where username assignment/validation actually lands).
model UserProfile {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @unique @db.Uuid
  username        String
  displayName     String
  bio             String?
  avatarObjectKey String?
  phoneVisibility PhoneVisibility @default(PRIVATE)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_profiles")
}

enum LegalDocumentType {
  TERMS
  PRIVACY
}

/// Immutable once created - the application never issues an UPDATE against
/// this table, only INSERT (a new version). See docs' migration rule:
/// "enum تغییرناپذیر فرض نشود و migration افزودن مقدار جدا باشد."
model LegalDocumentVersion {
  id          String            @id @default(uuid()) @db.Uuid
  type        LegalDocumentType
  version     Int
  contentHash String
  publicUrl   String
  effectiveAt DateTime          @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(6)

  termsAcceptances TermsAcceptance[]

  @@unique([type, version])
  @@map("legal_document_versions")
}

/// Append-only: a user's acceptance of one specific document version, tied
/// to the OTP challenge that produced it (Task 06 wires otpChallengeId for
/// real). No updatedAt - this is a point-in-time record, never revised.
model TermsAcceptance {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  documentType    LegalDocumentType
  documentVersion Int
  acceptedAt      DateTime          @db.Timestamptz(6)
  otpChallengeId  String
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  legalDocumentVersion LegalDocumentVersion @relation(fields: [documentType, documentVersion], references: [type, version], onDelete: Restrict)

  @@unique([userId, documentType, documentVersion])
  @@map("terms_acceptances")
}

/// Refresh-session family. `tokenFamilyId` groups every refresh rotation
/// descended from one login, so Task 06 can revoke the whole family on
/// reuse detection without needing this task's own logic yet.
model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  tokenFamilyId String    @db.Uuid
  refreshHash   String    @unique
  expiresAt     DateTime  @db.Timestamptz(6)
  revokedAt     DateTime? @db.Timestamptz(6)
  deviceId      String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Device {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  label      String?
  userAgent  String?
  lastSeenAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions Session[]

  @@index([userId])
  @@map("devices")
}

/// The fixed role vocabulary this task seeds - see
/// scripts/bootstrap-superadmin.mjs and RoleAssignment below.
enum RoleKey {
  USER
  SPACE_ADMIN
  MODERATOR
  SENIOR_ADMIN
  SUPERADMIN
  OPS
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         RoleKey  @unique
  displayName String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  roleAssignments RoleAssignment[]

  @@map("roles")
}

enum RoleScopeType {
  GLOBAL
  SPACE
}

/// `scopeId` is null for GLOBAL-scope assignments (e.g. SUPERADMIN, OPS) and
/// a space id for SPACE-scope ones (e.g. SPACE_ADMIN of one specific space -
/// Task 10+). `assignedBy` is a full relation, not a bare column, so every
/// assignment's grantor is queryable for audit purposes.
model RoleAssignment {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  roleId     String        @db.Uuid
  scopeType  RoleScopeType
  scopeId    String?       @db.Uuid
  assignedBy String        @db.Uuid
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @db.Timestamptz(6)

  user           User @relation("RoleAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  role           Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedByUser User @relation("RoleAssignmentAssignedBy", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, scopeType, scopeId])
  @@map("role_assignments")
}

enum OfficialIdentityClaimStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Minimal placeholder for the private, evidence-backed admin-eligibility
/// claim Task 09 actually builds the submit/verify flow for. The status
/// enum and 1:1 relation to User exist now so RoleAssignment's later
/// "non-bootstrap admins need a VERIFIED claim" rule (Task 09) has
/// something to check against from the start.
model OfficialIdentityClaim {
  id                 String                      @id @default(uuid()) @db.Uuid
  userId             String                      @unique @db.Uuid
  status             OfficialIdentityClaimStatus @default(PENDING)
  evidenceCiphertext String?
  reviewedBy         String?                     @db.Uuid
  reviewedAt         DateTime?                   @db.Timestamptz(6)
  createdAt          DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                    @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("official_identity_claims")
}

enum MfaStatus {
  PENDING
  ACTIVE
}

/// TOTP enrollment - one per user. `secretCiphertext` is AES-256-GCM
/// encrypted (same scheme as PhoneIdentity.phoneCiphertext), never stored
/// or logged in plaintext. `status` starts PENDING at enroll() and only
/// becomes ACTIVE once confirm() verifies the user actually has a working
/// authenticator (Task 09 acceptance: "enrollment ناقص secret فعال ندارد" -
/// an incomplete enrollment must not have an active secret). Re-enrolling
/// replaces the row rather than creating a second one.
model MfaEnrollment {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @db.Uuid
  secretCiphertext String
  status           MfaStatus @default(PENDING)
  confirmedAt      DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  recoveryCodes MfaRecoveryCode[]

  @@map("mfa_enrollments")
}

/// One-time-use fallback codes, generated once at confirm() and shown to
/// the user exactly then - only `codeHash` (plain SHA-256, same reasoning
/// as Session.refreshHash: the code itself carries the entropy) is ever
/// persisted. `usedAt` makes each code single-use.
model MfaRecoveryCode {
  id           String    @id @default(uuid()) @db.Uuid
  enrollmentId String    @db.Uuid
  codeHash     String    @unique
  usedAt       DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  enrollment MfaEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@index([enrollmentId])
  @@map("mfa_recovery_codes")
}

// Task 10: versioned public-space infrastructure. New migration, additive
// only (see the migration rule at the top of this file).

enum SpaceStatus {
  DRAFT
  PRECHECK_REQUIRED
  HUMAN_REVIEW
  PUBLISHED
  TEMPORARILY_SUSPENDED
  ARCHIVED
  REMOVED
}

/// `evaluateSpaceCreationGate`'s verdict (space-creation-gate.ts), snapshotted
/// onto the version it was computed for - never recomputed retroactively.
enum SpaceGateVerdict {
  ALLOW
  REVISE
  HUMAN_REVIEW
  BLOCK
}

/// The mutable "current state" pointer for a space. The actual definition
/// content lives entirely in SpaceDefinitionVersion rows - this table only
/// tracks identity (slug), lifecycle status, and who created it. "Current
/// version" is deliberately not a stored FK here (which would need a
/// nullable, circular Space<->SpaceDefinitionVersion reference); it is
/// simply the version with the highest `versionNumber` for this space,
/// resolved by the repository - one less piece of state to keep in sync.
model Space {
  id          String      @id @default(uuid()) @db.Uuid
  slug        String      @unique
  status      SpaceStatus @default(DRAFT)
  creatorId   String      @db.Uuid
  /// Denormalized, normalized (lowercased, ي/ك→ی/ک) "title purpose" of the
  /// *latest* version, maintained by space.repository.ts on every create/
  /// edit - Task 11's search needs a single indexable column rather than a
  /// join through SpaceDefinitionVersion for every query. See migration
  /// 20260906000000_space_search for the pg_trgm GIN index over this column
  /// (not expressible in schema.prisma - Prisma has no gin_trgm_ops type).
  searchText  String      @default("")
  publishedAt DateTime?   @db.Timestamptz(6)
  archivedAt  DateTime?   @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)

  creator            User                     @relation("SpaceCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  definitionVersions SpaceDefinitionVersion[]
  participationRoles SpaceParticipationRole[]
  roleMemberships    SpaceRoleMembership[]
  invites            SpaceInvite[]
  followers          SpaceFollower[]
  healthSnapshot     SpaceHealthSnapshot?
  cards              Card[]
  cardPins           CardPin[]

  @@index([status])
  @@map("spaces")
}

/// One immutable snapshot of a space's definition - every edit inserts a
/// new row (versionNumber + 1) rather than mutating an existing one, per
/// this task's own "هر edit یک version immutable" requirement.
/// `participationMethods`/`cardHints`/`primaryRoleIds`/`supplementaryRoleIds`
/// are JSON snapshots of string arrays: snapshotting the *ids* in use at
/// this version (rather than joining live SpaceParticipationRole rows)
/// means a version's own content never silently changes even if a role's
/// free-text title is edited later. `gateVerdict`/`gateReason` start null
/// (a freshly created/edited version has not been precheck()ed yet) and are
/// set once by `POST /spaces/:id/precheck` - editing again resets them to
/// null on the new version, so a stale ALLOW can never carry over to
/// content that has since changed (publish always re-requires a fresh
/// precheck on the exact version being published).
model SpaceDefinitionVersion {
  id                   String            @id @default(uuid()) @db.Uuid
  spaceId              String            @db.Uuid
  versionNumber        Int
  title                String
  purpose              String
  audience             String?
  participationMethods Json
  cardHints            Json?
  primaryRoleIds       Json
  supplementaryRoleIds Json
  policyVersion        Int
  gateVerdict          SpaceGateVerdict?
  gateReason           String?
  createdBy            String            @db.Uuid
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)

  space         Space @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  createdByUser User  @relation("SpaceDefinitionVersionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([spaceId, versionNumber])
  @@map("space_definition_versions")
}

/// A named participation slot within one space (e.g. "سازمان‌دهنده"). Not
/// itself versioned - only which role *ids* a definition version references
/// (and which of them are primary) is snapshotted, per
/// SpaceDefinitionVersion's own comment. `key` is a stable, space-scoped
/// slug so the same logical role survives a title edit.
model SpaceParticipationRole {
  id          String   @id @default(uuid()) @db.Uuid
  spaceId     String   @db.Uuid
  key         String
  title       String
  description String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  space       Space                 @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  memberships SpaceRoleMembership[]

  @@unique([spaceId, key])
  @@map("space_participation_roles")
}

/// A user's voluntary participation in one role of one space - optional and
/// multi-role (a user may hold several roles in the same space, or none).
/// Deliberately never a precondition for any public card/comment/chat API
/// (none of which exist yet - see this task's own review note).
model SpaceRoleMembership {
  id        String   @id @default(uuid()) @db.Uuid
  spaceId   String   @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  space Space                  @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  user  User                   @relation("SpaceRoleMembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  role  SpaceParticipationRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@map("space_role_memberships")
}

/// A random, revocable shortcut link to a space. Deliberately grants no
/// permission of its own in the MVP ("در MVP مجوز خصوصی نسازد") - resolving
/// a token only reveals which space it points to (subject to the same
/// visibility rules as `GET /spaces/:id`); it never auto-joins, auto-follows,
/// or auto-grants any role.
model SpaceInvite {
  id        String    @id @default(uuid()) @db.Uuid
  spaceId   String    @db.Uuid
  token     String    @unique
  createdBy String    @db.Uuid
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  space         Space @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  createdByUser User  @relation("SpaceInviteCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([spaceId])
  @@map("space_invites")
}

/// Task 11 builds the actual follow/unfollow endpoint and its idempotency
/// test - this table is the shape it needs, added now since Space itself is
/// this task's own model.
model SpaceFollower {
  id        String   @id @default(uuid()) @db.Uuid
  spaceId   String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  user  User  @relation("SpaceFollowerUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([spaceId, userId])
  @@map("space_followers")
}

// Task 13: independent, multi-dimensional space health - new migration,
// additive only (see the migration rule at the top of this file).

enum SpaceHealthStatus {
  NEW
  ACTIVE
  FRAGILE
  DORMANT
}

/// One row per space, upserted (not appended) by the daily worker job
/// (services/worker) - "job روزانهٔ idempotent": running it twice for the
/// same space on the same day produces the same row, not a duplicate.
/// Deliberately a *vector* of independent dimensions, never collapsed into
/// a single number anywhere in this schema, the API contract, or the UI
/// ("بدون score عددی واحد") - see space-health.service.ts for why most of
/// these fields are honestly 0/null at this point in the plan: their
/// underlying event streams (real cards, reactions, views, reservations,
/// reports) don't exist yet (Task 14/15/16/27+), and this task does not
/// fabricate data for features that aren't built.
model SpaceHealthSnapshot {
  id                     String            @id @default(uuid()) @db.Uuid
  spaceId                String            @unique @db.Uuid
  status                 SpaceHealthStatus
  cardCount              Int               @default(0)
  contributorCount       Int               @default(0)
  meaningfulViewCount    Int               @default(0)
  firstUseLatencySeconds Int?
  roleActivity           Json
  crossRoleCardRate      Float             @default(0)
  appliedRate            Float             @default(0)
  reservationClosedRate  Float             @default(0)
  reportQuality          Float?
  lastActivityAt         DateTime?         @db.Timestamptz(6)
  /// Suggestion codes computed alongside the snapshot ("فقط پیشنهاد و
  /// اعلان ثبت کن" - recorded here for the dashboard to display, never
  /// acted on automatically - no auto-archive anywhere in this task).
  suggestions            Json
  computedAt             DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(6)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  @@map("space_health_snapshots")
}

// Task 14: awareness-first multimedia cards. New migration, additive only.

/// Internal, correctable classification - "این kind داخلی و قابل اصلاح
/// است؛ user مجبور به انتخاب نیست". A card is always created AWARENESS
/// unless the author explicitly picks another; CardSemanticProfile keeps a
/// separate rule-based guess that never silently overrides the author's.
enum CardKind {
  AWARENESS
  OBSERVATION
  REUSABLE_RESOURCE
  CONSUMABLE_RESOURCE
  REQUEST
  SERVICE
  PARTICIPATION
  EVENT
}

enum CardStatus {
  ACTIVE
  ARCHIVED
  REMOVED
}

enum CardAttachmentKind {
  IMAGE
  AUDIO
  VIDEO
  FILE
  LINK
  APPROXIMATE_LOCATION
}

enum CardAttachmentStatus {
  PENDING
  PROCESSING
  READY
  REJECTED
}

/// The mutable pointer for a card. Its text content lives entirely in
/// CardRevision rows (every edit is a new immutable revision - "revision
/// immutable"); "current revision" is simply the highest revisionNumber,
/// resolved by the repository, same as Space's own current version.
model Card {
  id          String     @id @default(uuid()) @db.Uuid
  spaceId     String     @db.Uuid
  authorId    String     @db.Uuid
  kind        CardKind   @default(AWARENESS)
  status      CardStatus @default(ACTIVE)
  publishedAt DateTime   @default(now()) @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)

  space           Space                @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  author          User                 @relation("CardAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  revisions       CardRevision[]
  semanticProfile CardSemanticProfile?
  attachments     CardAttachment[]
  events          CardEvent[]
  comments        CardComment[]
  reactions       CardReaction[]
  pin             CardPin?
  reservation     CardReservation?

  @@index([spaceId, publishedAt])
  @@map("cards")
}

/// One immutable snapshot of a card's text - every edit inserts a new row.
/// `title` is derived from `body` when the author does not supply one (see
/// cards/card.service.ts's deriveTitle).
model CardRevision {
  id             String   @id @default(uuid()) @db.Uuid
  cardId         String   @db.Uuid
  revisionNumber Int
  title          String
  body           String
  editorId       String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  card   Card @relation(fields: [cardId], references: [id], onDelete: Restrict)
  editor User @relation("CardRevisionEditor", fields: [editorId], references: [id], onDelete: Restrict)

  @@unique([cardId, revisionNumber])
  @@map("card_revisions")
}

/// The "گونهٔ استنباطی" - a rule-based (Task 25 replaces it with AI)
/// classification kept alongside, never in place of, the author's own
/// `Card.kind`. Recomputed on every edit.
model CardSemanticProfile {
  id           String   @id @default(uuid()) @db.Uuid
  cardId       String   @unique @db.Uuid
  inferredKind CardKind
  confidence   Float
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  card Card @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@map("card_semantic_profiles")
}

/// `objectKey`/`contentType`/`sizeBytes`/`checksumSha256` are set by the
/// upload route once real bytes land; `linkUrl`/`locationLabel`/`approxLat`/
/// `approxLng` are for the two non-file kinds (LINK, APPROXIMATE_LOCATION),
/// stored verbatim with no server-side URL fetch. `cardId` is null between
/// upload-intent and being attached to a card. Only a READY attachment is
/// ever shown on a card or gets a signed read URL; a REJECTED one never
/// does.
model CardAttachment {
  id              String               @id @default(uuid()) @db.Uuid
  cardId          String?              @db.Uuid
  ownerId         String               @db.Uuid
  kind            CardAttachmentKind
  status          CardAttachmentStatus @default(PENDING)
  objectKey       String?
  contentType     String?
  sizeBytes       Int?
  checksumSha256  String?
  linkUrl         String?
  locationLabel   String?
  approxLat       Float?
  approxLng       Float?
  rejectionReason String?
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)

  card  Card? @relation(fields: [cardId], references: [id], onDelete: Restrict)
  owner User  @relation("CardAttachmentOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([cardId])
  @@index([ownerId, status])
  @@map("card_attachments")
}

/// Append-only per-card event log (card.created / card.revised / ...). A
/// separate concern from the generic OutboxEvent, which is also written in
/// the same transaction for async fan-out - "edit revision و outbox event
/// بسازد".
model CardEvent {
  id        String   @id @default(uuid()) @db.Uuid
  cardId    String   @db.Uuid
  eventType String
  actorId   String?  @db.Uuid
  payload   Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  card Card @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@index([cardId, createdAt])
  @@map("card_events")
}

enum CardCommentStatus {
  VISIBLE
  DELETED
}

/// A human public comment on a card - "thread عمومی". Deliberately a
/// different table from CardEvent (the machine log): "system event با
/// comment انسانی type مشترک نداشته باشد" - a system thread entry and a
/// person's comment can never be confused because they are different
/// entities, not two `type` values on one. `parentId` is a reply and is
/// constrained to the same card by the service, never cross-card. Editing
/// appends a CardCommentRevision (never mutates one); a soft delete flips
/// `status` to DELETED and clears the rendered body from the view while
/// every revision row and the audit trail stay intact.
model CardComment {
  id        String            @id @default(uuid()) @db.Uuid
  cardId    String            @db.Uuid
  authorId  String            @db.Uuid
  parentId  String?           @db.Uuid
  status    CardCommentStatus @default(VISIBLE)
  createdAt DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?         @db.Timestamptz(6)

  card      Card                  @relation(fields: [cardId], references: [id], onDelete: Restrict)
  author    User                  @relation("CardCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  parent    CardComment?          @relation("CardCommentReplies", fields: [parentId], references: [id], onDelete: Restrict)
  replies   CardComment[]         @relation("CardCommentReplies")
  revisions CardCommentRevision[]

  @@index([cardId, createdAt])
  @@index([parentId])
  @@map("card_comments")
}

/// One immutable snapshot of a comment's text - "comment و revision را
/// transactionally ذخیره کن". Every create and every edit inserts a row.
model CardCommentRevision {
  id             String   @id @default(uuid()) @db.Uuid
  commentId      String   @db.Uuid
  revisionNumber Int
  body           String
  editorId       String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  comment CardComment @relation(fields: [commentId], references: [id], onDelete: Restrict)
  editor  User        @relation("CardCommentRevisionEditor", fields: [editorId], references: [id], onDelete: Restrict)

  @@unique([commentId, revisionNumber])
  @@map("card_comment_revisions")
}

enum CardReactionType {
  SUPPORT
  USEFUL
  INTERESTED
  CELEBRATE
}

/// A weak, capped signal - "reaction toggle idempotent با unique
/// user/card/type". The `@@unique` makes a repeat of the same reaction a
/// no-op (the toggle removes it instead of inflating a count), so
/// popularity can never be gamed by re-clicking. Reactions feed only a
/// small capped coefficient in card ranking, never a standalone sort.
model CardReaction {
  id        String           @id @default(uuid()) @db.Uuid
  cardId    String           @db.Uuid
  userId    String           @db.Uuid
  type      CardReactionType
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  card Card @relation(fields: [cardId], references: [id], onDelete: Restrict)
  user User @relation("CardReactionUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([cardId, userId, type])
  @@index([cardId])
  @@map("card_reactions")
}

/// A creator/space-admin pin - "pin/unpin فقط creator/space-admin و دارای
/// audit". `@@unique([spaceId, cardId])` means a card is pinned at most
/// once; `position` orders a deliberately small set (the service caps the
/// count). A suspended/removed space or a non-ACTIVE card cannot be pinned.
model CardPin {
  id         String   @id @default(uuid()) @db.Uuid
  spaceId    String   @db.Uuid
  cardId     String   @unique @db.Uuid
  pinnedById String   @db.Uuid
  position   Int
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  space    Space @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  card     Card  @relation(fields: [cardId], references: [id], onDelete: Restrict)
  pinnedBy User  @relation("CardPinnedBy", fields: [pinnedById], references: [id], onDelete: Restrict)

  @@index([spaceId, position])
  @@map("card_pins")
}

enum ReservationState {
  ACTIVE
  RESERVED
  IN_USE
  RESERVATION_CLOSED
}

enum ReservationCloseReason {
  RETURNED
  COMPLETED
  TIME_ENDED
  OWNER_CLOSED
}

/// A card's reservation lifecycle - "مرحلهٔ accept را حذف کن؛ reserve موفق
/// فوراً RESERVED است". `@@unique(cardId)` means at most one row ever exists
/// per card, created lazily on the *first* reserve attempt (a card with no
/// row is the implicit ACTIVE/available state - see reservation.service.ts).
/// That same unique constraint is what makes two simultaneous first-reserves
/// safe: only one `create` can win, the other gets a constraint violation.
/// Every later transition (cancel/release/mark-in-use/close) is instead a
/// version-column compare-and-swap `UPDATE ... WHERE version = :expected`,
/// so a card can safely cycle ACTIVE -> RESERVED -> ACTIVE (via cancel or
/// release) more than once - only RESERVATION_CLOSED is terminal
/// ("reactivation/EXPIRED صفر" - once closed, this exact row never changes
/// state again; a similar-but-new card is Task 17's own separate action).
model CardReservation {
  id             String                  @id @default(uuid()) @db.Uuid
  cardId         String                  @unique @db.Uuid
  ownerId        String                  @db.Uuid
  reserverId     String?                 @db.Uuid
  state          ReservationState        @default(RESERVED)
  version        Int                     @default(0)
  conversationId String?                 @db.Uuid
  releaseReason  String?
  closeReason    ReservationCloseReason?
  reservedAt     DateTime                @default(now()) @db.Timestamptz(6)
  inUseAt        DateTime?               @db.Timestamptz(6)
  closedAt       DateTime?               @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(6)

  card     Card  @relation(fields: [cardId], references: [id], onDelete: Restrict)
  owner    User  @relation("CardReservationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  reserver User? @relation("CardReservationReserver", fields: [reserverId], references: [id], onDelete: Restrict)

  @@map("card_reservations")
}

enum ConversationKind {
  DIRECT
}

/// A minimal conversation shell - Task 19 adds real messages on top. Only
/// `DIRECT` exists for now; `pairKey` (the two member ids, sorted and
/// joined) is what makes `getOrCreateDirectConversation` idempotent - the
/// same two people always resolve to the same one conversation, reused
/// across every reservation they ever share, found via a single unique
/// lookup rather than a query over ConversationMember rows.
model Conversation {
  id        String           @id @default(uuid()) @db.Uuid
  kind      ConversationKind @default(DIRECT)
  pairKey   String?          @unique
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  members ConversationMember[]

  @@map("conversations")
}

model ConversationMember {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user         User         @relation("ConversationMemberUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

/// Deduplicates a retried mutating request - "header Idempotency-Key
/// اجباری". Scoped by (scope, actorId, key): the same literal key string
/// means different things for different actions or different callers, so
/// scope+actor are part of the uniqueness, not just the client-supplied
/// key. Only a *successful* response is ever cached (see
/// reservation.service.ts's `withIdempotency`) - a request that genuinely
/// failed can be retried under the same key rather than replaying the
/// failure forever.
model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  scope          String
  actorId        String   @db.Uuid
  key            String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([scope, actorId, key])
  @@map("idempotency_records")
}

enum AwarenessEventType {
  PRODUCED
  MEANINGFUL_VIEW
  PUBLIC_CONTRIBUTION
  RESERVED
  PRIVATE_CHAT_STARTED
  APPLIED
  RESERVATION_CLOSED
}

/// The full vocabulary is Task 18's ("رخداد، مشارکت‌های من و dashboard قیف
/// آگاهی"); this task only ever writes RESERVED / PRIVATE_CHAT_STARTED /
/// RESERVATION_CLOSED, one per reservation transition - "هر transition
/// CardEvent و AwarenessEvent بسازد". Deliberately minimal now - "فقط event
/// label، زمان و deep-link نگه دار و category/status مشتق نکن" (Task 18's
/// own words) - no private text, no derived status. `idempotencyKey` makes
/// a transition's event write-once even if the surrounding transaction were
/// ever retried outside the request-level Idempotency-Key cache.
model AwarenessEvent {
  id             String             @id @default(uuid()) @db.Uuid
  type           AwarenessEventType
  actorId        String             @db.Uuid
  subjectId      String             @db.Uuid
  deepLink       String?
  idempotencyKey String             @unique
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)

  @@index([actorId, createdAt])
  @@map("awareness_events")
}

/// Append-only. `targetId`/`actorId` are deliberately unconstrained (no FK) -
/// an audit event's target can be any entity type, and the record must
/// survive even if the target itself is later hard-deleted by a retention
/// job (out of MVP scope, but the shape allows for it).
model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @db.Uuid
  action        String
  targetType    String
  targetId      String?  @db.Uuid
  reason        String?
  correlationId String
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_events")
}
