# Frontend (Next.js) - existing
GEMINI_API_KEY=

# API base URL the web app's apiFetch client targets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# services/api - required in every environment (see services/api/src/config/env.ts).
# Production additionally fails fast if SESSION_HMAC_KEY/PHONE_ENCRYPTION_KEY are
# missing, short, or left at a placeholder/default-looking value.
# SESSION_HMAC_KEY is also read directly by the web app (lib/auth/session.ts,
# Task 07) to verify the access_token cookie without a network round trip to
# the API - it must be the exact same value in both places.
DATABASE_URL=postgresql://taavon:taavon_dev_password@localhost:5432/taavon
SHADOW_DATABASE_URL=postgresql://taavon:taavon_dev_password@localhost:5432/taavon_shadow
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=taavon-dev
S3_ACCESS_KEY=taavon_dev_access_key
S3_SECRET_KEY=taavon_dev_secret_key
SESSION_HMAC_KEY=
PHONE_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:4300

# Task 05 - E.164 phone number for scripts/bootstrap-superadmin.mjs. Read
# only by that script, never by the server, and never hardcoded in source.
BOOTSTRAP_SUPERADMIN_PHONE=

# Task 06 - real SMS gateway for OTP delivery. Required in production only
# (server refuses to start without both - see sms-provider.ts); outside
# production the dev sink provider is used regardless of these being set.
SMS_PROVIDER_WEBHOOK_URL=
SMS_PROVIDER_API_KEY=

# docker-compose.yml - optional overrides (defaults match the values above).
POSTGRES_PASSWORD=taavon_dev_password

# Task 23 - AI orchestration. Both optional: with no key the orchestrator runs
# with no provider and every capability answers from its rule-based fallback,
# which is a supported way to run rather than a broken one. The budget is a
# daily ceiling across everyone, in micros; leave it unset for no ceiling.
GEMINI_API_KEY=
AI_DAILY_BUDGET_MICROS=

# Lets a production deployment log in with no SMS gateway by keeping the dev
# OTP sink, and the /v1/auth/otp/_dev-sink route that reads codes back out of
# it, available. This is a deliberate hole: anyone who can reach the API can
# request a code for any phone number and then read it. Only ever set it on a
# deployment that has no real accounts on it. A real SMS_PROVIDER_* pair wins
# over it, so leaving it set after configuring a gateway cannot silently keep
# the hole open. Leave empty or 'false' everywhere else.
ALLOW_TEST_LOGIN_WITHOUT_SMS=false

# Optional override for the Gemini model, for when Google retires the one the
# provider defaults to (it answers 404 once retired, which the orchestrator
# can only report as a provider failure). Leave empty to use the default.
GEMINI_MODEL=

# This server's own public IP. The API and worker pin the public hostname to
# it so their internal calls to object storage never depend on an external DNS
# lookup succeeding. Only used by deploy/compose.production.yml.
PUBLIC_HOST_IP=

# Where the model is called. Leave empty for Google's own endpoint. Set it to
# any gateway that speaks the same `{model}:generateContent?key=` shape when a
# deployment cannot reach Google directly - verified on 2026-09-18 that the
# production host cannot: Google answers "User location is not supported",
# and it is the address it sees, not the key, that it refuses.
GEMINI_BASE_URL=
