# Frontend (Next.js) - existing
GEMINI_API_KEY=

# API base URL the web app's apiFetch client targets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# services/api - required in every environment (see services/api/src/config/env.ts).
# Production additionally fails fast if SESSION_HMAC_KEY/PHONE_ENCRYPTION_KEY are
# missing, short, or left at a placeholder/default-looking value.
# SESSION_HMAC_KEY is also read directly by the web app (lib/auth/session.ts,
# Task 07) to verify the access_token cookie without a network round trip to
# the API - it must be the exact same value in both places.
DATABASE_URL=postgresql://taavon:taavon_dev_password@localhost:5432/taavon
SHADOW_DATABASE_URL=postgresql://taavon:taavon_dev_password@localhost:5432/taavon_shadow
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=taavon-dev
S3_ACCESS_KEY=taavon_dev_access_key
S3_SECRET_KEY=taavon_dev_secret_key
SESSION_HMAC_KEY=
PHONE_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:4300

# Task 05 - E.164 phone number for scripts/bootstrap-superadmin.mjs. Read
# only by that script, never by the server, and never hardcoded in source.
BOOTSTRAP_SUPERADMIN_PHONE=

# Task 06 - real SMS gateway for OTP delivery. Required in production only
# (server refuses to start without both - see sms-provider.ts); outside
# production the dev sink provider is used regardless of these being set.
SMS_PROVIDER_WEBHOOK_URL=
SMS_PROVIDER_API_KEY=

# docker-compose.yml - optional overrides (defaults match the values above).
POSTGRES_PASSWORD=taavon_dev_password
